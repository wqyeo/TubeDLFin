<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.TubeDLFin</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.TubeDLFin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime, so never copied into the plugin. -->
    <PackageReference Include="Jellyfin.Controller" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.TubeDLFin.Tests" />
    <!-- Lets NSubstitute fake internal interfaces in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <Import Project="Web.targets" />

</Project>
