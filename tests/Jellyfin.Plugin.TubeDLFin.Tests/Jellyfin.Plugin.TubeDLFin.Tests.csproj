<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- JPRM runs "dotnet publish" on the whole solution; keep tests out of the plugin output. -->
    <IsPublishable>false</IsPublishable>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <!-- Unlike the plugin, tests run outside Jellyfin, so they need its assemblies at runtime. -->
    <PackageReference Include="Jellyfin.Controller" />
    <PackageReference Include="Jellyfin.Model" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.TubeDLFin/Jellyfin.Plugin.TubeDLFin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- build.yaml is checked against the code, so copy it next to the test assembly. -->
    <None Include="../../build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Directory.Build.props" Link="Directory.Build.props.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../web/src/plugin.ts" Link="plugin.ts.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
